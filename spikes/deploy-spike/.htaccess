# BS CMS — Spike C Content Negotiation (.htaccess)
# Serves index.md twin when client sends Accept: text/markdown

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Check if client explicitly requests Markdown
  RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.md -f
  RewriteRule ^(.*)$ $1/index.md [L]

  RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
  RewriteCond %{REQUEST_FILENAME}\.md -f
  RewriteRule ^(.*)$ $1.md [L]
</IfModule>

<IfModule mod_headers.c>
  # Ensure caches distinguish between HTML and Markdown responses
  Header append Vary Accept

  # Set correct content type when serving markdown files
  <FilesMatch "\.md$">
    ForceType "text/markdown; charset=utf-8"
    Header set X-Robots-Tag "noindex, follow"
  </FilesMatch>
</IfModule>
