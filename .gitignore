# Dependencies
node_modules/
/core/vendor/
/.pnpm-store/

# Storage and logs
/core/storage/cache/*
!/core/storage/cache/.gitkeep
/core/storage/logs/*
!/core/storage/logs/.gitkeep
/core/storage/keys/*
!/core/storage/keys/.gitkeep
/core/storage/private/*
!/core/storage/private/.gitkeep
/core/storage/tmp/*
!/core/storage/tmp/.gitkeep
.phpunit.result.cache
.php-cs-fixer.cache


# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Build outputs
dist/
/build/
/starter/dist/
starter/.astro/
starter/.cache/
/coverage/
/tools/dist/
*.tsbuildinfo

# Built admin app copied into the PHP document root by CI or the local build
# (never committed; core/public/index.php serves /admin from here at runtime).
/core/public/admin/

# Playwright artifacts
test-results/
playwright-report/

# OS and Editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.suo
*.user
