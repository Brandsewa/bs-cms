---
import BaseLayout from '../layouts/BaseLayout.astro';
import PreviewRenderer from '../components/preview/PreviewRenderer';
import { getCanonicalUrl } from '../lib/bs';
---

<BaseLayout
  title="Preview Mode | BS CMS"
  description="Live content preview from BS CMS."
  canonical={getCanonicalUrl('/preview/')}
  robots={{ noindex: true, nofollow: true }}
>
  {/* Client island: reads collection/id/token from the query string at runtime,
      fetches the draft from the CMS preview API and renders Puck content. */}
  <PreviewRenderer client:only="react" />
</BaseLayout>
