---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadCollectionEntries, getCanonicalUrl } from '../lib/bs';
import { Render } from '@puckeditor/core';
import { puckConfig, sanitizePuckData } from '@bs/page-builder';

export async function getStaticPaths() {
  let pages: any[] = [];
  try {
    pages = await loadCollectionEntries('pages');
  } catch {
    // Fallback if pages collection is empty or not yet published
    pages = [];
  }

  return pages.map((page: any) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props as any;
// Puck page-builder content (undefined for pages authored before/without the
// editor); sanitize never throws and guarantees Puck `Data` with `root`.
const puckData = sanitizePuckData(page.content);
const hasPuckContent = puckData.content.length > 0 || Object.keys(puckData.root).length > 0;
---

<BaseLayout
  title={`${page.title} | BS CMS`}
  description={page.summary || `${page.title} on BS CMS.`}
  canonical={getCanonicalUrl(`/${page.slug}/`)}
  structuredData={page.structured_data}
  robots={page.seo?.robots}
>
  {page.html_code ? (
    // Custom-coded page: HTML from the admin code editor, rendered verbatim.
    <Fragment set:html={page.html_code} />
  ) : (
  <article class="post-detail">
    <header class="post-header">
      <h1>{page.title}</h1>
      {page.summary && (
        <p style="font-size: 1.15rem; color: var(--color-text-secondary); margin-top: 0.5rem;">
          {page.summary}
        </p>
      )}
    </header>

    <div class="post-content">
      {hasPuckContent ? (
        // Page-builder content: server-rendered Puck markup (no hydration).
        <Render config={puckConfig} data={puckData} />
      ) : (
        <p>{page.summary || 'Content for this page.'}</p>
      )}
    </div>
  </article>
  )}
</BaseLayout>
