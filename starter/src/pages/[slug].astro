---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadCollectionEntries, getCanonicalUrl } from '../lib/bs';

export async function getStaticPaths() {
  let pages: any[] = [];
  try {
    pages = await loadCollectionEntries('pages');
  } catch {
    // Fallback if pages collection is empty or not yet published
    pages = [];
  }

  return pages.map((page: any) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props as any;
const blocks = Array.isArray(page.blocks) ? page.blocks : [];
---

<BaseLayout
  title={`${page.title} | BS CMS`}
  description={page.summary || `${page.title} on BS CMS.`}
  canonical={getCanonicalUrl(`/${page.slug}/`)}
  structuredData={page.structured_data}
  robots={page.seo?.robots}
>
  {page.html_code ? (
    // Custom-coded page: HTML from the admin code editor, rendered verbatim.
    <Fragment set:html={page.html_code} />
  ) : (
  <article class="post-detail">
    <header class="post-header">
      <h1>{page.title}</h1>
      {page.summary && (
        <p style="font-size: 1.15rem; color: var(--color-text-secondary); margin-top: 0.5rem;">
          {page.summary}
        </p>
      )}
    </header>

    <div class="post-content">
      {blocks.length > 0 ? (
        blocks.map((block: any) => {
          if (block.type === 'hero') {
            return (
              <section class="hero" style="margin: 1.5rem 0; padding: 2rem;">
                {block.heading && <h2>{block.heading}</h2>}
                {block.text && <p class="hero-subtitle">{block.text}</p>}
              </section>
            );
          }
          if (block.type === 'text') {
            return <p>{block.content || block.text}</p>;
          }
          if (block.type === 'contact_form') {
            const formHandle = block.form_handle || 'contact-us';
            return (
              <section class={`contact-form-section ${block.card_style ? 'form-card-container' : ''}`} style="margin: 2rem 0; padding: 1.5rem; border: 1px solid var(--color-border, #e5e7eb); border-radius: 8px;">
                {block.heading && <h2 style="margin-bottom: 0.5rem;">{block.heading}</h2>}
                {block.subheading && <p style="color: var(--color-text-secondary, #6b7280); margin-bottom: 1.25rem;">{block.subheading}</p>}
                <div data-bs-form={formHandle}></div>
              </section>
            );
          }
          return null;
        })
      ) : (
        <p>{page.summary || 'Content for this page.'}</p>
      )}
    </div>
  </article>
  )}
</BaseLayout>
