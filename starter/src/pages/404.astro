---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCanonicalUrl } from '../lib/bs';
---

<BaseLayout
  title="404: Page Not Found | BS CMS"
  description="The page you are looking for does not exist."
  canonical={getCanonicalUrl('/404')}
  robots={{ noindex: true, nofollow: true }}
>
  <div class="not-found-container">
    <div class="not-found-code">404</div>
    <h1>Page Not Found</h1>
    <p style="color: var(--color-text-secondary); max-width: 500px; margin: 0 auto 2rem; font-size: 1.1rem;">
      We couldn't find the page you were looking for. It may have been moved, deleted, or never existed.
    </p>
    <a href="/" class="embed-load-button" style="text-decoration: none; display: inline-block;">
      Return to Home
    </a>
  </div>
</BaseLayout>
