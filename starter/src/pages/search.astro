---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCanonicalUrl } from '../lib/bs';
---

<BaseLayout
  title="Search | BS CMS"
  description="Search all articles, pages, and documentation on BS CMS."
  canonical={getCanonicalUrl('/search/')}
>
  <div class="search-page" style="max-width: 800px; margin: 2rem auto; padding: 0 1rem;">
    <header style="margin-bottom: 2rem;">
      <h1>Site Search</h1>
      <p style="color: var(--color-text-secondary); margin-top: 0.5rem;">
        Search published posts and pages fast with zero node daemons.
      </p>
    </header>

    <div style="margin-bottom: 2rem;">
      <input
        type="search"
        id="search-input"
        placeholder="Type to search content..."
        aria-label="Search content"
        style="width: 100%; padding: 0.75rem 1rem; font-size: 1.1rem; border: 1px solid var(--color-border-default, #ccc); border-radius: 6px; background: var(--color-bg, #fff); color: var(--color-text, #111);"
      />
    </div>

    <div id="search-status" aria-live="polite" style="margin-bottom: 1rem; color: var(--color-text-secondary); font-size: 0.95rem;"></div>
    <ul id="search-results" style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1.25rem;"></ul>
  </div>

  <script is:inline>
    const input = document.getElementById('search-input');
    const status = document.getElementById('search-status');
    const results = document.getElementById('search-results');

    let pagefind = null;

    async function loadSearch() {
      if (!pagefind) {
        try {
          pagefind = await import('/pagefind/pagefind.js');
        } catch (e) {
          console.warn('Pagefind search bundle unavailable:', e);
        }
      }
      return pagefind;
    }

    if (input) {
      input.addEventListener('input', async (e) => {
        const query = e.target.value.trim();
        if (!query) {
          results.innerHTML = '';
          status.textContent = '';
          return;
        }

        status.textContent = 'Searching...';
        const searcher = await loadSearch();
        if (!searcher) {
          status.textContent = 'Search indexing is only available on built production output.';
          return;
        }

        const res = await searcher.search(query);
        const dataList = await Promise.all(res.results.slice(0, 10).map(r => r.data()));

        if (dataList.length === 0) {
          status.textContent = `No results found for "${query}".`;
          results.innerHTML = '';
          return;
        }

        status.textContent = `Found ${res.results.length} results:`;
        results.innerHTML = dataList.map((item, idx) => {
          const url = res.results[idx].url;
          return `
            <li style="border-bottom: 1px solid var(--color-border-muted, #eee); padding-bottom: 1rem;">
              <a href="${url}" style="font-size: 1.15rem; font-weight: 600; text-decoration: none; color: var(--color-primary, #2563eb);">
                ${item.meta?.title || 'Untitled'}
              </a>
              <p style="margin: 0.35rem 0 0 0; color: var(--color-text-secondary, #555); font-size: 0.95rem; line-height: 1.4;">
                ${item.excerpt || ''}
              </p>
            </li>
          `;
        }).join('');
      });
    }
  </script>
</BaseLayout>
