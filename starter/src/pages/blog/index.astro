---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadCollectionEntries, getCanonicalUrl } from '../../lib/bs';

const entries = await loadCollectionEntries('posts');
---

<BaseLayout
  title="Blog | BS CMS"
  description="Latest articles and benchmarks."
  canonical={getCanonicalUrl('/blog/')}
>
  <h1>Blog</h1>
  <p>Published static articles from BS CMS.</p>
  {entries.length > 0 ? (
    <ul>
      {entries.map((entry) => (
        <li>
          <a href={`/blog/${entry.slug}/`}>{entry.title}</a>
          {entry.excerpt && <p>{entry.excerpt}</p>}
        </li>
      ))}
    </ul>
  ) : (
    <p class="empty-state">No posts have been published yet.</p>
  )}
</BaseLayout>
