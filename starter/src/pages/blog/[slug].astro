---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { renderToHtml, renderToMarkdown } from '@bs/renderer';
import { loadCollectionEntries, getCanonicalUrl } from '../../lib/bs';

export async function getStaticPaths() {
  const entries = await loadCollectionEntries('posts');

  return entries.map((entry: any) => {
    // Render using @bs/renderer
    const doc = entry.body && typeof entry.body === 'object' ? entry.body : {
      type: 'doc',
      content: [{ type: 'paragraph', content: [{ type: 'text', text: String(entry.content || entry.title || '') }] }],
    };

    const html = renderToHtml(doc as any);
    const markdown = renderToMarkdown(doc as any);

    return {
      params: { slug: entry.slug },
      props: {
        post: {
          ...entry,
          renderedHtml: html,
          renderedMarkdown: markdown,
        },
      },
    };
  });
}

const { post } = Astro.props as any;
---

<BaseLayout
  title={`${post.title} | BS CMS`}
  description={post.excerpt || `Read ${post.title} on BS CMS.`}
  canonical={getCanonicalUrl(`/blog/${post.slug}/`)}
  structuredData={post.structured_data}
  robots={post.seo?.robots}
>
  <article class="post-detail">
    <header class="post-header">
      <nav aria-label="Breadcrumb" style="margin-bottom: 1rem;">
        <a href="/blog" style="text-decoration: none; font-size: 0.9rem;">&larr; Back to all posts</a>
      </nav>
      <h1>{post.title}</h1>
      {post.published_at && (
        <div class="post-meta">
          <time datetime={post.published_at}>
            {new Date(post.published_at).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
          {post.reading_time && <span>&bull; {post.reading_time} min read</span>}
        </div>
      )}
    </header>

    <div class="post-content" set:html={post.renderedHtml} />
  </article>
</BaseLayout>
