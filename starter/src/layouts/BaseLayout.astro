---
import '../styles/tokens.css';
import { escapeJsonLd, escapeAttr, getCanonicalUrl, getSiteMetadata } from '../lib/bs';
import { brandCssVars, readableOn } from '../lib/brand';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  structuredData?: unknown;
  robots?: {
    noindex?: boolean;
    nofollow?: boolean;
  };
}

const siteMeta = await getSiteMetadata();
const brandCss = brandCssVars(siteMeta.branding);
const brand = siteMeta.branding || null;
const brandLogo = brand?.logo_url || '';
const brandLogoDark = brand?.logo_dark_url || brand?.logo_url || '';
const brandAlt = brand?.logo_alt || siteMeta.name + ' logo';
const onPrimary = readableOn(brand?.color_primary);

const {
  title,
  description = siteMeta.description,
  canonical = getCanonicalUrl(Astro.url.pathname),
  structuredData,
  robots,
} = Astro.props;

// Ensure structured_data canonical IDs and URLs align with our site URL policy if present
let resolvedStructuredData = structuredData;
if (structuredData && typeof structuredData === 'object') {
  const jsonStr = JSON.stringify(structuredData);
  const targetSiteUrl = canonical.replace(/\/+$/, '');
  // Replace dev/cms/internal host references in structured data with the canonical public SITE_URL
  const canonicalStr = jsonStr
    .replace(/http:\/\/localhost:\d+/g, targetSiteUrl)
    .replace(/https:\/\/localhost:\d+/g, targetSiteUrl)
    .replace(/http:\/\/127\.0\.0\.1:\d+/g, targetSiteUrl)
    .replace(/https:\/\/127\.0\.0\.1:\d+/g, targetSiteUrl);
  resolvedStructuredData = JSON.parse(canonicalStr);
}

const safeDescription = escapeAttr(description);

const robotsContent = [
  robots?.noindex ? 'noindex' : 'index',
  robots?.nofollow ? 'nofollow' : 'follow',
  'max-image-preview:large',
].join(', ');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={safeDescription} />
    <meta name="robots" content={robotsContent} />
    <link rel="canonical" href={canonical} />
    {brand?.favicon_url && <link rel="icon" href={brand.favicon_url} />}
    {brandCss && <style is:inline set:html={brandCss} />}
    {brand && (
      <style is:inline
        set:html={`.enquire-btn:hover, .footer-btn:hover { background: ${brand.color_primary || 'inherit'}; border-color: ${brand.color_primary || 'inherit'}; color: ${onPrimary}; }`}
      />
    )}

    <!-- Open Graph & Twitter -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={safeDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={safeDescription} />

    {resolvedStructuredData && (
      <script
        type="application/ld+json"
        is:inline
        set:html={escapeJsonLd(resolvedStructuredData)}
      />
    )}
  </head>
  <body>
    <header>
      <nav class="site-nav" aria-label="Main Navigation">
        <a href="/" class="site-brand">
          {brandLogo ? (
            <img class="brand-logo" src={brandLogo} alt={brandAlt} />
          ) : (
            <>
              <span class="brand-leaf" aria-hidden="true">&#10087;</span>
              <span class="brand-text">
                <span class="brand-name">{siteMeta.name.toUpperCase()}</span>
                <span class="brand-tag">SEEDS &bull; PLANTS &bull; A GREENER TOMORROW</span>
              </span>
            </>
          )}
        </a>
        <ul class="nav-links">
          {siteMeta.navigation.map((item) => (
            <li>
              <a href={item.url} target={item.target || undefined} rel={item.target === '_blank' ? 'noopener noreferrer' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
        <a class="enquire-btn" href="/contact-us/">Enquire <span aria-hidden="true">&rarr;</span></a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="footer-grid">
        <div class="footer-brand">
          {brandLogoDark ? (
            <img class="footer-logo-img" src={brandLogoDark} alt={brandAlt} />
          ) : (
            <p class="footer-logo">&#10087; {siteMeta.name.toUpperCase()}</p>
          )}
          <p class="footer-blurb">Supplying quality flower and vegetable seeds, bulbs and planting material to growers in India and around the world.</p>
        </div>
        <div class="footer-col">
          <p class="footer-h">Quick Links</p>
          <ul>
            {siteMeta.navigation.slice(0, 5).map((item) => (
              <li><a href={item.url}>{item.label}</a></li>
            ))}
          </ul>
        </div>
        <div class="footer-col">
          <p class="footer-h">Our Range</p>
          <ul>
            <li><a href="/our-stories/">Flower Seeds</a></li>
            <li><a href="/our-stories/">Vegetable Seeds</a></li>
            <li><a href="/blueberry/">Fruit &amp; Horticulture</a></li>
          </ul>
        </div>
        <div class="footer-col footer-news">
          <p class="footer-h">Newsletter</p>
          <p>Get the latest updates, growing tips and new varieties.</p>
          <a class="footer-btn" href="/contact-us/">Get in touch &rarr;</a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} {siteMeta.name}. All rights reserved.</p>
        <div class="footer-links">
          <a href="/terms-and-condition/">Privacy Policy</a>
          <a href="/terms-and-condition/">Terms of Use</a>
          <a href="/sitemap.xml">Sitemap</a>
        </div>
      </div>
    </footer>

    <!-- Embed activation loader conforming to CSP script-src 'self' -->
    <script src="/embed.js" is:inline></script>
  </body>
</html>
