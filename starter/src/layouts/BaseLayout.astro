---
import '../styles/tokens.css';
import { escapeJsonLd, escapeAttr, getCanonicalUrl, getSiteMetadata } from '../lib/bs';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  structuredData?: unknown;
  robots?: {
    noindex?: boolean;
    nofollow?: boolean;
  };
}

const siteMeta = await getSiteMetadata();

const {
  title,
  description = siteMeta.description,
  canonical = getCanonicalUrl(Astro.url.pathname),
  structuredData,
  robots,
} = Astro.props;

// Ensure structured_data canonical IDs and URLs align with our site URL policy if present
let resolvedStructuredData = structuredData;
if (structuredData && typeof structuredData === 'object') {
  const jsonStr = JSON.stringify(structuredData);
  const targetSiteUrl = canonical.replace(/\/+$/, '');
  // Replace dev/cms/internal host references in structured data with the canonical public SITE_URL
  const canonicalStr = jsonStr
    .replace(/http:\/\/localhost:\d+/g, targetSiteUrl)
    .replace(/https:\/\/localhost:\d+/g, targetSiteUrl)
    .replace(/http:\/\/127\.0\.0\.1:\d+/g, targetSiteUrl)
    .replace(/https:\/\/127\.0\.0\.1:\d+/g, targetSiteUrl);
  resolvedStructuredData = JSON.parse(canonicalStr);
}

const safeDescription = escapeAttr(description);

const robotsContent = [
  robots?.noindex ? 'noindex' : 'index',
  robots?.nofollow ? 'nofollow' : 'follow',
  'max-image-preview:large',
].join(', ');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={safeDescription} />
    <meta name="robots" content={robotsContent} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph & Twitter -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={safeDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={safeDescription} />

    {resolvedStructuredData && (
      <script
        type="application/ld+json"
        is:inline
        set:html={escapeJsonLd(resolvedStructuredData)}
      />
    )}
  </head>
  <body>
    <header>
      <nav class="site-nav" aria-label="Main Navigation">
        <a href="/" class="site-brand">
          <span>{siteMeta.name}</span>
          <span class="badge">Static</span>
        </a>
        <ul class="nav-links">
          {siteMeta.navigation.map((item) => (
            <li>
              <a href={item.url} target={item.target || undefined} rel={item.target === '_blank' ? 'noopener noreferrer' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="footer-content">
        <p>&copy; {new Date().getFullYear()} {siteMeta.name}. Zero Node daemons in production.</p>
        <div class="footer-links">
          <a href="/llms.txt">llms.txt</a>
          <a href="/sitemap.xml">Sitemap</a>
          <a href="/robots.txt">Robots</a>
        </div>
      </div>
    </footer>

    <!-- Embed activation loader conforming to CSP script-src 'self' -->
    <script src="/embed.js" is:inline></script>
  </body>
</html>
