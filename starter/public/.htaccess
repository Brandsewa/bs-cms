# Generated by BS CMS (Phase 7 Starter - Static Site Configuration)
# Coexists cleanly with the parent CMS front-controller rules.
# Provides Markdown content negotiation, strict security headers, and asset caching.

Options -Indexes
Options -MultiViews
DirectoryIndex index.html

<IfModule mod_mime.c>
    AddType text/markdown;charset=utf-8 .md
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Content Negotiation: Serve Markdown twins when Accept: text/markdown is requested
    RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
    RewriteRule ^$ index.md [L]

    RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
    RewriteRule ^index\.html$ index.md [L]

    RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_FILENAME}/index.md -f
    RewriteRule ^(.*)$ $1/index.md [L]

    RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
    RewriteCond %{REQUEST_FILENAME}.md -f
    RewriteRule ^(.*)$ $1.md [L]
</IfModule>

# Force correct content-type and Vary: Accept headers for markdown twins
<FilesMatch "\.md$">
    ForceType "text/markdown; charset=utf-8"
    Header set Content-Type "text/markdown; charset=utf-8"
    Header append Vary Accept
</FilesMatch>

# Security Headers & CSP (Zero third-party script execution at load)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header set Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data: https:; frame-src 'self' https://www.youtube-nocookie.com https://player.vimeo.com https://open.spotify.com https://w.soundcloud.com https://codepen.io https://platform.twitter.com https://x.com https://twitter.com; connect-src 'self' https://bskickstarter.com;"
</IfModule>

# Caching directives
<IfModule mod_expires.c>
    ExpiresActive On
    # Cache HTML documents shortly with must-revalidate
    ExpiresByType text/html "access plus 60 seconds"
    ExpiresByType text/markdown "access plus 60 seconds"
    # Long cache for hashed static assets
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
</IfModule>
