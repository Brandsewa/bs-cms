{
    "handle": "pages",
    "kind": "collection",
    "label_singular": "Page",
    "label_plural": "Pages",
    "description": "Hierarchical site pages",
    "icon": "file-text",
    "is_system": true,
    "has_public_pages": true,
    "route_pattern": "/{slug}",
    "list_route_pattern": null,
    "features": {
        "drafts": true,
        "versions": true,
        "scheduling": true,
        "seo": true,
        "hierarchy": true,
        "soft_delete": true,
        "manual_order": true
    },
    "title_field": "title",
    "slug_source": "title",
    "default_sort": "position",
    "fields": {
        "template": {
            "handle": "template",
            "label": "Page Template",
            "type": "enum",
            "required": true,
            "is_filterable": true,
            "show_in_list": true,
            "config": {
                "options": [
                    "default",
                    "landing",
                    "full_width"
                ]
            }
        },
        "summary": {
            "handle": "summary",
            "label": "Answer Summary",
            "type": "textarea",
            "required": false,
            "show_in_list": false,
            "config": {
                "max_length": 500
            }
        },
        "show_in_nav": {
            "handle": "show_in_nav",
            "label": "Show in Navigation",
            "type": "boolean",
            "required": false,
            "is_filterable": true,
            "show_in_list": true,
            "config": {}
        },
        "nav_label": {
            "handle": "nav_label",
            "label": "Navigation Label",
            "type": "text",
            "required": false,
            "show_in_list": false,
            "config": {
                "max_length": 64
            }
        }
    }
}
