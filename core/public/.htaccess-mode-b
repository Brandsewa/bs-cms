# BS CMS Hardened Mode B Root .htaccess
# Used when the document root contains core/ (e.g. host root public_html/ contains core/):
# Denies access to private directories in core/ (storage, config, src, vendor, etc.)
# and routes front requests to core/public/index.php.

Options -Indexes
Options -MultiViews
DirectoryIndex core/public/index.php index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Allow ACME / OAuth / MCP discovery (.well-known)
    RewriteCond %{REQUEST_URI} ^/\.well-known/ [NC]
    RewriteRule ^ core/public/index.php [L,QSA]

    # 2. Deny all other dotfiles (.env, .git, etc.)
    RewriteRule (^\.|/\.) - [F,L]

    # 3. Explicitly deny direct access to private directories inside core/
    RewriteRule ^core/(storage|config|src|bin|migrations|vendor)(\/|$) - [F,L]
    RewriteRule ^(storage|config|src|bin|migrations|vendor)(\/|$) - [F,L]

    # 4. Route direct static assets in /admin and /media to core/public/
    RewriteCond %{DOCUMENT_ROOT}/core/public%{REQUEST_URI} -f
    RewriteRule ^(admin|media)/(.*)$ core/public/$1/$2 [L]

    # 4b. Admin SPA client-side routing fallback: route non-file requests under /admin to /admin/index.html
    RewriteCond %{REQUEST_URI} ^/admin(/.*)?$ [NC]
    RewriteRule ^admin(?:/.*)?$ core/public/admin/index.html [L]

    # 5. Route all other requests to front controller inside core/public/
    RewriteRule ^ core/public/index.php [L,QSA]
</IfModule>
