#!/usr/bin/env bash
set -euo pipefail

# tools/build-release: Produces production-ready release zip: bs-cms-<version>.zip
# Layout matching repository core/ directory:
# - core/src/
# - core/config/
# - core/migrations/
# - core/bin/
# - core/public/ (index.php, .htaccess, .htaccess-mode-b, media/.htaccess, admin/)
# - core/storage/ (cache/, logs/, keys/, tmp/, uploads/ with .gitkeep)
# - core/vendor/ (installed with --no-dev --classmap-authoritative)
# - core/composer.json
# Excludes: tests, node_modules, .git, dev configurations, docs.

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VERSION="${1:-1.0.0}"
BUILD_DIR="${REPO_ROOT}/build/release-staging"
ZIP_NAME="bs-cms-${VERSION}.zip"
RELEASE_ZIP="${REPO_ROOT}/build/${ZIP_NAME}"

echo "Building BS CMS release ${VERSION}..."

rm -rf "${REPO_ROOT}/build"
mkdir -p "${BUILD_DIR}/core/public"
mkdir -p "${BUILD_DIR}/core/storage/cache"
mkdir -p "${BUILD_DIR}/core/storage/logs"
mkdir -p "${BUILD_DIR}/core/storage/keys"
mkdir -p "${BUILD_DIR}/core/storage/tmp"
mkdir -p "${BUILD_DIR}/core/storage/uploads"

# 1. Copy core application files
echo "Copying core application files..."
cp -r "${REPO_ROOT}/core/src" "${BUILD_DIR}/core/"
cp -r "${REPO_ROOT}/core/config" "${BUILD_DIR}/core/"
cp -r "${REPO_ROOT}/core/migrations" "${BUILD_DIR}/core/"
cp -r "${REPO_ROOT}/core/resources" "${BUILD_DIR}/core/"
cp -r "${REPO_ROOT}/core/bin" "${BUILD_DIR}/core/"
cp "${REPO_ROOT}/core/composer.json" "${BUILD_DIR}/core/"

# 2. Copy public directory files into core/public/
echo "Copying public assets..."
cp -r "${REPO_ROOT}/core/public/"* "${BUILD_DIR}/core/public/"
cp -r "${REPO_ROOT}/core/public/."* "${BUILD_DIR}/core/public/" 2>/dev/null || true

# 2b. Build and bundle admin UI SPA into core/public/admin/
if [ -d "${REPO_ROOT}/admin" ] && [ -f "${REPO_ROOT}/admin/package.json" ]; then
    echo "Building admin UI (npm run build -w admin)..."
    if [ ! -d "${REPO_ROOT}/node_modules" ]; then
        echo "Installing npm dependencies in root..."
        ( cd "${REPO_ROOT}" && npm ci )
    fi
    (
        cd "${REPO_ROOT}"
        npm run build -w admin
    )
    if [ -d "${REPO_ROOT}/admin/dist" ]; then
        echo "Copying admin dist into core/public/admin/..."
        mkdir -p "${BUILD_DIR}/core/public/admin"
        cp -r "${REPO_ROOT}/admin/dist/"* "${BUILD_DIR}/core/public/admin/"
    else
        echo "WARNING: admin/dist was not produced by npm run build -w admin!"
    fi
else
    echo "Note: admin/ directory not present on this branch; skipping admin bundle (tolerated until PR #14 lands)."
fi

# 3. Create .gitkeep in storage directories
touch "${BUILD_DIR}/core/storage/cache/.gitkeep"
touch "${BUILD_DIR}/core/storage/logs/.gitkeep"
touch "${BUILD_DIR}/core/storage/keys/.gitkeep"
touch "${BUILD_DIR}/core/storage/tmp/.gitkeep"
touch "${BUILD_DIR}/core/storage/uploads/.gitkeep"

# 4. Install production-only composer dependencies in staging
echo "Installing production dependencies (--no-dev --classmap-authoritative)..."
(
    cd "${BUILD_DIR}/core"
    composer install --no-dev --prefer-dist --no-progress --classmap-authoritative --optimize-autoloader
)

# 4b. Set explicit permissions before packaging
echo "Applying explicit permissions (dirs 755, files 644, bin/bs 755, storage dirs 700)..."
find "${BUILD_DIR}" -type d -exec chmod 755 {} + 2>/dev/null || true
find "${BUILD_DIR}" -type f -exec chmod 644 {} + 2>/dev/null || true
chmod 755 "${BUILD_DIR}/core/bin/bs" 2>/dev/null || true
chmod 700 "${BUILD_DIR}/core/storage" 2>/dev/null || true
chmod 700 "${BUILD_DIR}/core/storage/"* 2>/dev/null || true

# 5. Create zip archive
echo "Packaging ${RELEASE_ZIP}..."
if command -v zip >/dev/null 2>&1; then
    (
        cd "${BUILD_DIR}"
        zip -q -r "${RELEASE_ZIP}" .
    )
else
    php -r '
        $dir = $argv[1];
        $zipFile = $argv[2];
        $zip = new ZipArchive();
        if ($zip->open($zipFile, ZipArchive::CREATE | ZipArchive::OVERWRITE) !== true) {
            fwrite(STDERR, "Cannot create zip: $zipFile\n");
            exit(1);
        }
        $files = new RecursiveIteratorIterator(
            new RecursiveDirectoryIterator($dir, RecursiveDirectoryIterator::SKIP_DOTS),
            RecursiveIteratorIterator::SELF_FIRST
        );
        foreach ($files as $file) {
            $filePath = $file->getRealPath();
            $relativePath = substr($filePath, strlen(realpath($dir)) + 1);
            $relativePath = str_replace("\\", "/", $relativePath);
            $isDir = $file->isDir();
            $isStorage = str_starts_with($relativePath, "core/storage");
            $isBin = ($relativePath === "core/bin/bs");

            if ($isDir) {
                $zip->addEmptyDir($relativePath);
                $mode = $isStorage ? 040700 : 040755;
            } else {
                $zip->addFile($filePath, $relativePath);
                $mode = $isBin ? 0100755 : 0100644;
            }
            $zip->setExternalAttributesName($relativePath, ZipArchive::OPSYS_UNIX, $mode << 16);
        }
        $zip->close();
    ' "${BUILD_DIR}" "${RELEASE_ZIP}"
fi

# Ensure external attributes are explicitly set for UNIX on all entries
php -r '
    $zipFile = $argv[1];
    $zip = new ZipArchive();
    if ($zip->open($zipFile) !== true) { exit(1); }
    for ($i = 0; $i < $zip->numFiles; $i++) {
        $name = $zip->getNameIndex($i);
        $isDir = str_ends_with($name, "/");
        $isStorage = str_starts_with($name, "core/storage");
        $isBin = ($name === "core/bin/bs");
        if ($isDir) {
            $mode = $isStorage ? 040700 : 040755;
        } else {
            $mode = $isBin ? 0100755 : 0100644;
        }
        $zip->setExternalAttributesIndex($i, ZipArchive::OPSYS_UNIX, $mode << 16);
    }
    $zip->close();
' "${RELEASE_ZIP}"

# 6. Verify zip size, permissions, and contents
SIZE_BYTES=$(wc -c < "${RELEASE_ZIP}" | tr -d ' ')
SIZE_MB=$(echo "scale=2; ${SIZE_BYTES} / 1048576" | bc -l 2>/dev/null || awk "BEGIN {printf \"%.2f\", ${SIZE_BYTES}/1048576}")
echo "Release archive created: ${RELEASE_ZIP} (${SIZE_MB} MB)"

# Check budget < 10 MB
MAX_BYTES=$((10 * 1024 * 1024))
if [ "${SIZE_BYTES}" -ge "${MAX_BYTES}" ]; then
    echo "ERROR: Release zip size (${SIZE_MB} MB) exceeds 10 MB budget!"
    exit 1
fi

# Check permissions: Fail on any 777 or 666 entry
echo "Verifying permissions inside release zip..."
php -r '
    $zipFile = $argv[1];
    $zip = new ZipArchive();
    if ($zip->open($zipFile) !== true) { exit(1); }
    $unsafe = 0;
    for ($i = 0; $i < $zip->numFiles; $i++) {
        $name = $zip->getNameIndex($i);
        $zip->getExternalAttributesIndex($i, $opsys, $attr);
        $mode = ($attr >> 16) & 0777;
        if ($mode === 0777 || $mode === 0666 || ($mode & 0002) !== 0) {
            echo "ERROR: Unsafe permissions " . decoct($mode) . " on entry: " . $name . "\n";
            $unsafe++;
        }
    }
    $zip->close();
    if ($unsafe > 0) {
        exit(1);
    }
' "${RELEASE_ZIP}"

if command -v zipinfo >/dev/null 2>&1; then
    if zipinfo "${RELEASE_ZIP}" | grep -E "(rwxrwxrwx|rw-rw-rw-)"; then
        echo "ERROR: zipinfo detected 777 or 666 permissions in release package!"
        exit 1
    fi
fi

# Check for banned dev artifacts
echo "Checking for dev files inside release zip..."
BANNED_FOUND=0
if command -v unzip >/dev/null 2>&1; then
    unzip -l "${RELEASE_ZIP}" | grep -E "(phpunit|tests/|\.env|node_modules|phpstan|\.php-cs-fixer)" && BANNED_FOUND=1 || true
else
    php -r '
        $zip = new ZipArchive();
        if ($zip->open($argv[1]) !== true) { exit(1); }
        $banned = false;
        for ($i = 0; $i < $zip->numFiles; $i++) {
            $name = $zip->getNameIndex($i);
            if (preg_match("/(phpunit|tests\/|\.env|node_modules|phpstan|\.php-cs-fixer)/", $name)) {
                echo "Banned entry found: $name\n";
                $banned = true;
            }
        }
        $zip->close();
        exit($banned ? 1 : 0);
    ' "${RELEASE_ZIP}" || BANNED_FOUND=1
fi

if [ "${BANNED_FOUND}" -eq 1 ]; then
    echo "ERROR: Development or test files detected in release package!"
    exit 1
fi

echo "SUCCESS: BS CMS release ${VERSION} built and verified clean (${SIZE_MB} MB < 10 MB)."
