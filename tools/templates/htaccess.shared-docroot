# Enforce UTF-8 charset on text and script assets
AddDefaultCharset UTF-8
AddCharset UTF-8 .js .css .json

# BS CMS Apache / LiteSpeed Front-Controller Configuration
# Enforces clean routing, security headers, dotfile blocking, and PHP execution restriction.

Options -Indexes
Options -MultiViews
DirectoryIndex index.html index.php
DirectorySlash Off

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass Authorization header to PHP in CGI / FastCGI / LiteSpeed SAPI environments
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Deny dotfiles (.git, .env, .htaccess, etc.) except for /.well-known/ (required for ACME and discovery)
    RewriteCond %{REQUEST_URI} !^/\.well-known/ [NC]
    RewriteRule (^\.|/\.) - [F,L]

    # Block direct access to any PHP files except index.php
    RewriteCond %{THE_REQUEST} \.php[/\s?] [NC]
    RewriteCond %{REQUEST_URI} !^/index\.php$
    RewriteRule .* - [F,L]

    # Block direct static access to admin/index.html (route to index.php for security headers)
    RewriteCond %{THE_REQUEST} /admin/index\.html [NC]
    RewriteRule ^admin/index\.html$ index.php [L,QSA]

    # Serve real physical asset files under /admin/ (JS, CSS, images, fonts, theme-init.js) statically
    RewriteCond %{REQUEST_URI} ^/admin/(assets/|.*\.(js|css|png|jpg|jpeg|gif|svg|woff2?|ttf|eot|ico|webp|webmanifest|map)$) [NC]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Missing static assets under /admin/assets/ or files with extensions return 404 (never SPA index)
    RewriteCond %{REQUEST_URI} ^/admin/assets/ [NC,OR]
    RewriteCond %{REQUEST_URI} ^/admin/.*\.[a-zA-Z0-9]+$ [NC]
    RewriteRule ^ - [R=404,L]

    # Markdown content negotiation (static site twins) - must run before the
    # existing-file pass-through, which would stop / requests as directory hits
    RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
    RewriteRule ^$ index.md [L]

    RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
    RewriteRule ^index\.html$ index.md [L]

    RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_FILENAME}/index.md -f
    RewriteRule ^(.*)$ $1/index.md [L]

    RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
    RewriteCond %{REQUEST_FILENAME}.md -f
    RewriteRule ^(.*)$ $1.md [L]

    # If the requested file or directory physically exists outside /admin/ (e.g. media/), serve it directly
    RewriteCond %{REQUEST_URI} !^/admin(/.*)?$ [NC]
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route all /admin paths, client-side routes, and API/OAuth/MCP requests to front controller index.php
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    # Long-lived caching for Vite-hashed production assets under /admin/assets/
    RewriteCond %{REQUEST_URI} ^/admin/assets/ [NC]
    RewriteRule .* - [E=HASHED_ADMIN_ASSET:1]
    Header set Cache-Control "public, max-age=31536000, immutable" env=HASHED_ADMIN_ASSET
</IfModule>

# --- Static site (Astro starter) additions ---
<IfModule mod_mime.c>
    AddType text/markdown;charset=utf-8 .md
</IfModule>

<FilesMatch "\.md$">
    ForceType "text/markdown; charset=utf-8"
    Header set Content-Type "text/markdown; charset=utf-8"
    Header append Vary Accept
</FilesMatch>

# Per-page CSP lives in each static page's <meta> tag (script hashes); this
# header only adds what the meta policy cannot express.
<IfModule mod_headers.c>
    Header set Content-Security-Policy "frame-ancestors 'self'; img-src 'self' data: https:; frame-src 'self' https://www.youtube-nocookie.com https://player.vimeo.com https://open.spotify.com https://w.soundcloud.com https://codepen.io https://platform.twitter.com https://x.com https://twitter.com; connect-src 'self' https://bskickstarter.com;"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 60 seconds"
    ExpiresByType text/markdown "access plus 60 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
</IfModule>
